# PostgreSQL 연결 문자열 (Railway에서는 Postgres 애드온의 DATABASE_URL 참조 변수 사용)
DATABASE_URL="postgresql://user:password@localhost:5432/supplierchangeover"

# 세션 서명용 비밀키 (긴 랜덤 문자열로 변경하세요)
SESSION_SECRET="change-me-to-a-long-random-string"

# 파일 첨부 저장 경로 (Railway에서는 볼륨 마운트 경로 예: /data/uploads)
UPLOAD_DIR="./uploads"
